rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    match /health/check {
      allow read: if true;
    }

    // Ticket Validation
    function isValidTicket(data) {
      return data.keys().hasAll(['domain', 'title', 'severity', 'status', 'createdBy', 'createdAt', 'updatedAt']) &&
             data.keys().size() >= 7 && data.keys().size() <= 9 &&
             data.domain in ['Energy', 'Transport', 'Water', 'Comms', 'Emergency', 'Environment'] &&
             data.title is string && data.title.size() <= 200 &&
             data.severity in ['low', 'medium', 'high', 'critical'] &&
             data.status in ['open', 'resolved', 'closed'] &&
             data.createdBy == request.auth.uid &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    match /tickets/{ticketId} {
      allow list: if isVerified();
      allow get: if isVerified();
      allow create: if isVerified() && isValidTicket(incoming()) && isValidId(ticketId);
      allow update: if isVerified() && existing().createdBy == request.auth.uid && (
        // Action: Generic Edit (title, description, severity, status)
        (incoming().diff(existing()).affectedKeys().hasAny(['title', 'description', 'severity', 'status', 'updatedAt']) &&
         incoming().updatedAt == request.time)
      );
    }
  }
}
